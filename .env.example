# Yerelde farklı bir backend kullanılacaksa bu değer ezilebilir. Boş bırakıldığında
# production panel endpoint'i kullanılır.
PUBLIC_REPORT_QUERY_ENDPOINT=https://panel.noktagarage.com/api/public/report-query

