---
import "@fontsource/barlow-condensed/600.css";
import "@fontsource/barlow-condensed/700.css";
import "@fontsource/barlow-condensed/800.css";
import "../styles/global.css";
import BrandIntro from "../components/BrandIntro.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import StickyContactBar from "../components/StickyContactBar.astro";
import { siteSettings } from "../data/cms";

interface Props {
  title?: string;
  description?: string;
  reviewMode?: boolean;
  hideStickyContact?: boolean;
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
  showBrandIntro?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  article?: {
    headline: string;
    publishedTime: string;
    section: string;
  };
}

const {
  title = siteSettings.defaultSeo.title,
  description = siteSettings.defaultSeo.description,
  reviewMode = false,
  hideStickyContact = false,
  canonicalPath,
  ogImage,
  noindex = false,
  showBrandIntro = false,
  structuredData,
  article,
} = Astro.props;

const siteOrigin = "https://noktagarage.com";
const requestedCanonicalPath = canonicalPath ?? Astro.url.pathname;
const normalizedCanonicalPath = requestedCanonicalPath === "/"
  ? "/"
  : `${requestedCanonicalPath.replace(/\/$/, "")}/`;
const canonicalUrl = new URL(normalizedCanonicalPath, siteOrigin).toString();
const resolvedOgImage = ogImage ?? siteSettings.defaultSocialImage;
const absoluteOgImage = resolvedOgImage ? new URL(resolvedOgImage, siteOrigin).toString() : undefined;
const websiteStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${siteOrigin}/#website`,
  url: siteOrigin,
  name: siteSettings.brandName,
  inLanguage: "tr-TR",
};
const articleStructuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: article.headline,
      description,
      datePublished: article.publishedTime,
      articleSection: article.section,
      mainEntityOfPage: canonicalUrl,
      ...(absoluteOgImage ? { image: absoluteOgImage } : {}),
      author: { "@type": "Organization", name: "Nokta Garage" },
      publisher: {
        "@type": "Organization",
        name: siteSettings.brandName,
        logo: { "@type": "ImageObject", url: `${siteOrigin}/logo-640.webp` },
      },
    }
  : undefined;
const articleBreadcrumbStructuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Ana Sayfa", item: siteOrigin },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${siteOrigin}/blog` },
        { "@type": "ListItem", position: 3, name: article.headline, item: canonicalUrl },
      ],
    }
  : undefined;
const additionalStructuredData = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const structuredDataItems = [
  websiteStructuredData,
  ...additionalStructuredData,
  ...(articleStructuredData ? [articleStructuredData] : []),
  ...(articleBreadcrumbStructuredData ? [articleBreadcrumbStructuredData] : []),
];
---

<!doctype html>
<html lang="tr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#951a29" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:locale" content="tr_TR" />
    <meta property="og:site_name" content="Nokta Garage" />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}
    {article && <meta property="article:published_time" content={article.publishedTime} />}
    {article && <meta property="article:section" content={article.section} />}
    <meta name="twitter:card" content={absoluteOgImage ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}
    <meta name="robots" content={(reviewMode || noindex) ? "noindex,nofollow" : "index,follow,max-image-preview:large"} />
    {structuredDataItems.map((item) => <script is:inline type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <link rel="icon" type="image/png" href={siteSettings.favicon} />
    <title>{title}</title>
  </head>
  <body class:list={{ "without-sticky-contact": hideStickyContact }}>
    {showBrandIntro && <BrandIntro />}
    <Header />
    <main id="ana-icerik">
      <slot />
    </main>
    <Footer />
    {!hideStickyContact && <StickyContactBar />}
    <script>
      import { installSiteEventHooks } from "../lib/site-events";
      installSiteEventHooks();
    </script>
  </body>
</html>
