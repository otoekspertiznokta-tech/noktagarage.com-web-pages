<div class="brand-intro" id="brand-intro" aria-hidden="true">
  <div class="brand-intro__mark">
    <img src="/logo-640.webp" srcset="/logo-320.webp 320w, /logo-640.webp 640w" sizes="min(52vw, 360px)" alt="" width="640" height="640" decoding="async" />
  </div>
  <span>NOKTA GARAGE</span>
</div>

<script is:inline>
  (() => {
    const intro = document.getElementById("brand-intro");
    if (!intro) return;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reducedMotion) {
      intro.dataset.state = "skipped";
      return;
    }

    intro.dataset.state = "playing";
    window.setTimeout(() => {
      intro.dataset.state = "finished";
    }, 1800);
  })();
</script>
