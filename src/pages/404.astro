---
import { ArrowLeft, CircleQuestionMark, Phone } from "@lucide/astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import ButtonLink from "../components/ButtonLink.astro";
import { siteSettings } from "../data/cms";
---

<SiteLayout
  title="Sayfa Bulunamadı | Nokta Garage"
  description="Aradığınız sayfa bulunamadı. Nokta Garage ana sayfasına veya ekspertiz paketlerine dönebilirsiniz."
  canonicalPath="/404"
  noindex
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="not-found__code" aria-hidden="true">
      <span>4</span><CircleQuestionMark size={62} stroke-width={1.45} /><span>4</span>
    </div>
    <p class="eyebrow">Yanlış Dönüş</p>
    <h1 id="not-found-title">Aradığın sayfa burada değil.</h1>
    <p>Bağlantı değişmiş veya adres yanlış yazılmış olabilir. Ana sayfaya dönebilir ya da doğrudan bize ulaşabilirsin.</p>
    <div class="not-found__actions">
      <ButtonLink href="/"><ArrowLeft size={18} /> Ana Sayfaya Dön</ButtonLink>
      <ButtonLink href={siteSettings.phoneHref} variant="outline" eventName="click_phone" eventContext="404"><Phone size={18} /> Hemen Ara</ButtonLink>
    </div>
  </section>
</SiteLayout>
